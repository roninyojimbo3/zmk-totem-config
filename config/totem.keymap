//
// TOTEM — Silso custom 38-key layout
// Updated from Nick Coutsos Keymap Editor output:
// - Diagrams updated to match actual bindings
// - Semantic layer names cleaned without changing layer behavior
// - Ctrl+Alt+Delete macro added at BT + Q
// - Username macro "10.Yojimbo" added at BT + W
// - 10 direct Bluetooth profile selectors added
// - BT + Y = clear all profiles; BT + H = clear current profile
//

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUM  1
#define NAV  2
#define BT   3
#define GAME 4

/*
 * Retained for the outer Caps/Ctrl binding and the current right-thumb
 * tap/hold binding. Letter HRMs use HML/HMR below to match the Typeractive.
 */
&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        /*
         * Home-row mods matched to the Typeractive Corne.
         * Applied only to A/S/D/F and J/K/L/; on the Base layer.
         */
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

       combos {
        compatible = "zmk,combos";

        combo_game_toggle {
            timeout-ms = <50>;
            key-positions = <20 31>;
            bindings = <&tog GAME>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };

        cad_macro: cad_macro {
            label = "Ctrl Alt Delete";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LALT>,
                <&macro_tap &kp DEL>,
                <&macro_release &kp LCTRL &kp LALT>;
        };

        username_macro: username_macro {
            label = "10.Yojimbo";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&kp N1 &kp N0 &kp DOT &kp LS(Y) &kp O &kp J &kp I &kp M &kp B &kp O>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";

            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     E     ┃     R     ┃     T     ┃   ┃     Y     ┃     U     ┃     I     ┃     O     ┃     P     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   A/GUI   ┃   S/ALT   ┃  D/CTRL   ┃  F/SHIFT  ┃     G     ┃   ┃     H     ┃  J/SHIFT  ┃  K/CTRL   ┃   L/ALT   ┃   ;/GUI   ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃CAPS/CTRL  ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     N     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     '     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃  TAB/NAV  ┃ BSPC/SHIFT┃    NUM    ┃   ┃   ENTER   ┃   SPACE   ┃  DEL/ESC  ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //
            // Thumb notation is tap / hold:
            // TAB/NAV = tap Tab, hold NAV; BSPC/SHIFT = tap Backspace, hold SHIFT;
            // NUM = Number layer only; DEL/ESC = tap Delete, hold Escape.

            bindings = <
                           &kp Q                    &kp W       &kp E        &kp R          &kp T            &kp Y      &kp U        &kp I        &kp O       &kp P
                           &hml LGUI A               &hml LALT S  &hml LCTRL D  &hml LSHIFT F    &kp G            &kp H      &hmr RSHIFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI
&mt LEFT_CONTROL CAPSLOCK  &kp Z                    &kp X       &kp C        &kp V          &kp B            &kp N      &kp M        &kp COMMA    &kp DOT     &kp SLASH      &kp APOS
                                                   &lt NAV TAB     &mt LSHIFT BACKSPACE &mo NUM       &kp ENTER        &kp SPACE  &mt ESC DEL
            >;
        };

        num_layer {
            label = "NUM";

            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     1     ┃     2     ┃     3     ┃     4     ┃     5     ┃   ┃     6     ┃     7     ┃     8     ┃     9     ┃     0     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃    F11    ┃    F12    ┃           ┃           ┃           ┃   ┃     -     ┃     =     ┃     [     ┃     ]     ┃     \     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃ CAPS WORD ┃    F1     ┃    F2     ┃    F3     ┃    F4     ┃    F5     ┃   ┃    F6     ┃    F7     ┃    F8     ┃    F9     ┃    F10    ┃     `     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    PASS   ┃    PASS   ┃    PASS   ┃   ┃    PASS   ┃    PASS   ┃    PASS   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
            &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &kp N7     &kp N8            &kp N9             &kp NUMBER_0
            &kp F11       &kp F12       &none         &none         &none           &kp MINUS     &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH
&caps_word  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp F6        &kp F7     &kp F8            &kp F9             &kp F10               &kp GRAVE
                                        &trans        &trans        &trans          &trans        &trans     &trans
            >;
        };

        nav_layer {
            label = "NAV";

            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃           ┃           ┃    UP     ┃           ┃   HOME    ┃   ┃  PAGE UP  ┃ LEFT CLICK┃ MOUSE UP  ┃RIGHT CLICK┃ SCROLL UP ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃           ┃   LEFT    ┃   DOWN    ┃   RIGHT   ┃    END    ┃   ┃ PAGE DOWN ┃MOUSE LEFT ┃MOUSE DOWN ┃MOUSE RIGHT┃SCROLL DOWN┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃   PASS    ┃   PREV    ┃ PLAY/PAUSE┃   NEXT    ┃   VOL-    ┃   VOL+    ┃   ┃           ┃MID CLICK  ┃    MB4    ┃    MB5    ┃SCROLL LEFT┃SCROLL RGHT┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    PASS   ┃    PASS   ┃    PASS   ┃   ┃    PASS   ┃    PASS   ┃    BT     ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            // Thumb notation is hold:
            // BT = Bluetooth layer 
            bindings = <
        &none       &none              &kp UP_ARROW    &none              &kp HOME           &kp PG_UP      &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &msc SCRL_UP
        &none       &kp LEFT           &kp DOWN        &kp RIGHT          &kp END            &kp PAGE_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN
&trans  &kp K_PREV  &kp K_PLAY_PAUSE  &kp K_NEXT      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP    &none          &mkp MCLK       &mkp MB4        &mkp MB5         &msc SCRL_LEFT  &msc SCRL_RIGHT
                                      &trans           &trans             &trans             &trans         &trans          &mo BT
            >;
        };

        bt_layer {
            label = "BT";

            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃ CTRLALTDEL┃10.YOJIMBO ┃  OUT USB  ┃  OUT BT   ┃           ┃   ┃ CLR ALL BT┃           ┃           ┃           ┃BOOTLOADER ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃    BT6    ┃    BT7    ┃    BT8    ┃    BT9    ┃   BT10    ┃   ┃ CLR CUR BT┃           ┃           ┃           ┃           ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃    BT1    ┃    BT2    ┃    BT3    ┃    BT4    ┃    BT5    ┃   ┃           ┃           ┃           ┃           ┃ SYS RESET ┃STUDIO UNLK┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    PASS   ┃    PASS   ┃    PASS   ┃   ┃    PASS   ┃    PASS   ┃    PASS   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //
            // All ten Bluetooth profile selectors stay on the left half:
            // Z = BT1, X = BT2, C = BT3, V = BT4, B = BT5;
            // A = BT6, S = BT7, D = BT8, F = BT9, G = BT10.
            //
            // Required controls:
            // Y position = clear all Bluetooth profiles
            // H position = clear only the currently selected Bluetooth profile

          bindings = <
      &cad_macro  &username_macro  &out OUT_USB  &out OUT_BLE  &none          &bt BT_CLR_ALL  &none   &none   &none   &bootloader
      &bt BT_SEL 5  &bt BT_SEL 6   &bt BT_SEL 7  &bt BT_SEL 8  &bt BT_SEL 9   &bt BT_CLR      &none   &none   &none   &none
&trans       &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4    &none   &none   &none   &none   &sys_reset  &studio_unlock
                                      &trans  &trans        &trans         &trans          &trans  &trans
>;
        }; 

        game_layer {
            label = "GAME";

            //
            //              ┌──────┬──────┬──────┬──────┬──────┐              ┌──────┬──────┬──────┬──────┬──────┐
            //              │  Q   │  W   │  E   │  R   │  T   │              │  1   │  2   │  3   │  4   │  5   │
            //              ├──────┼──────┼──────┼──────┼──────┤              ├──────┼──────┼──────┼──────┼──────┤
            //              │  A   │  S   │  D   │  F   │  G   │              │  6   │  7   │  8   │  9   │  0   │
            //       ┌──────┼──────┼──────┼──────┼──────┼──────┤              ├──────┼──────┼──────┼──────┼──────┼──────┐
            //       │SHIFT │  Z   │  X   │  C   │  V   │  B   │              │ ALT  │  P   │  M   │  I   │  F   │ ESC  │
            //       └──────┴──────┴──────┴──────┴──────┴──────┘              └──────┴──────┴──────┴──────┴──────┴──────┘
            //                            ┌──────┬──────┬──────┐      ┌──────┬──────┬──────┐
            //                            │CTRL  │BACKSP│SPACE │      │ENTER │ TAB  │DELETE│
            //                            └──────┴──────┴──────┘      └──────┴──────┴──────┘
            //
            // GAME notes:
            // - No HRMs.
            // - No mod-taps.
            // - No layer-taps.
            // - WASD stays in normal position.
            // - Left thumbs: Ctrl / Backspace / Space.
            // - Toggle GAME with left orphan + right orphan combo.
            //

            bindings = <
                &kp Q          &kp W          &kp E          &kp R          &kp T              &kp N1       &kp N2       &kp N3       &kp N4       &kp N5
                &kp A          &kp S          &kp D          &kp F          &kp G              &kp N6       &kp N7       &kp N8       &kp N9       &kp N0
                &kp LSHIFT     &kp Z          &kp X          &kp C          &kp V      &kp B     &kp LALT     &kp P        &kp M        &kp I        &kp F        &kp ESC
                                                                      &kp LCTRL    &kp BACKSPACE &kp SPACE    &kp ENTER    &kp TAB      &kp DEL
            >;
        };  
    };
};
